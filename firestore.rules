rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function pathPengguna(uid) {
      return /databases/$(database)/documents/pengguna/$(uid);
    }

    function pathKelas(kelasId) {
      return /databases/$(database)/documents/kelas/$(kelasId);
    }

    function pathAnggota(kelasId, uid) {
      return /databases/$(database)/documents/keanggotaan/$(kelasId + '_' + uid);
    }

    function pathSesi(sesiId) {
      return /databases/$(database)/documents/sesi/$(sesiId);
    }

    function pathQr(sesiId) {
      return /databases/$(database)/documents/sesi/$(sesiId)/rahasia/qr;
    }

    function pathPresensi(sesiId, uid) {
      return /databases/$(database)/documents/presensi/$(sesiId + '_' + uid);
    }

    function pathIzin(sesiId, uid) {
      return /databases/$(database)/documents/izin/$(sesiId + '_' + uid);
    }

    function teksValid(nilai, batasMaks) {
      return nilai is string
        && nilai.size() > 0
        && nilai.size() <= batasMaks
        && nilai.matches('.*\\S.*');
    }

    function peranValid(peran) {
      return signedIn()
        && get(pathPengguna(request.auth.uid)).data.peran == peran;
    }

    function isAsisten() {
      return peranValid('ASISTEN');
    }

    function isPraktikan() {
      return peranValid('PRAKTIKAN');
    }

    function isPemilikKelas(kelasId) {
      return isAsisten()
        && get(pathKelas(kelasId)).data.asistenUid == request.auth.uid;
    }

    function kelasAktif(kelasId) {
      return get(pathKelas(kelasId)).data.diarsipkan == false;
    }

    function anggotaAktif(kelasId, uid) {
      return get(pathAnggota(kelasId, uid)).data.kelasId == kelasId
        && get(pathAnggota(kelasId, uid)).data.uid == uid
        && get(pathAnggota(kelasId, uid)).data.status == 'AKTIF';
    }

    function punyaRiwayatPresensi(sesiId, uid) {
      return exists(pathPresensi(sesiId, uid));
    }

    function punyaRiwayatIzin(sesiId, uid) {
      return exists(pathIzin(sesiId, uid));
    }

    function kelasDimilikiAsistenDiData(data) {
      return data.kelasId is string && isPemilikKelas(data.kelasId);
    }

    function sesiDimilikiAsisten(sesiId) {
      return isAsisten()
        && get(pathSesi(sesiId)).data.kelasId is string
        && isPemilikKelas(get(pathSesi(sesiId)).data.kelasId);
    }

    function praktikanDapatBacaSesi(sesiId, kelasId, diarsipkan) {
      return isPraktikan()
        && (
          (
            diarsipkan == false
            && kelasAktif(kelasId)
            && anggotaAktif(kelasId, request.auth.uid)
          )
          || punyaRiwayatPresensi(sesiId, request.auth.uid)
          || punyaRiwayatIzin(sesiId, request.auth.uid)
        );
    }

    function izinKosongDapatDibacaPraktikan(izinId) {
      let uid = request.auth.uid;
      let panjangSesiId = izinId.size() - uid.size() - 1;
      let sesiId = panjangSesiId > 0
        ? izinId[0:panjangSesiId]
        : '';

      return isPraktikan()
        && panjangSesiId > 0
        && izinId == sesiId + '_' + uid
        && exists(pathSesi(sesiId))
        && praktikanDapatBacaSesi(
          sesiId,
          get(pathSesi(sesiId)).data.kelasId,
          get(pathSesi(sesiId)).data.diarsipkan
        );
    }

    function classDataValid(data) {
      return data.keys().hasAll([
          'namaPraktikum', 'asistenUid', 'gracePeriodMenit',
          'nominalDenda', 'diarsipkan', 'dibuatPada'
        ])
        && data.keys().hasOnly([
          'namaPraktikum', 'asistenUid', 'labId',
          'gracePeriodMenit', 'nominalDenda', 'diarsipkan',
          'dibuatPada', 'diperbaruiPada'
        ])
        && teksValid(data.namaPraktikum, 100)
        && data.asistenUid is string
        && (!('labId' in data) || data.labId == null || teksValid(data.labId, 128))
        && data.gracePeriodMenit is int
        && data.gracePeriodMenit >= 0
        && data.gracePeriodMenit <= 120
        && data.nominalDenda is int
        && data.nominalDenda >= 0
        && data.nominalDenda <= 1000000
        && data.diarsipkan is bool
        && data.dibuatPada is timestamp
        && (!('diperbaruiPada' in data) || data.diperbaruiPada is timestamp);
    }

    function sesiDataValid(data) {
      return data.keys().hasAll([
          'kelasId', 'judul', 'lokasi', 'waktuMulai', 'waktuSelesai',
          'statusSesi', 'diarsipkan'
        ])
        && data.keys().hasOnly([
          'kelasId', 'judul', 'labId', 'lokasi', 'waktuMulai', 'waktuSelesai',
          'statusSesi', 'diarsipkan', 'notificationEventId'
        ])
        && data.kelasId is string
        && (!('labId' in data) || data.labId == null || teksValid(data.labId, 128))
        && teksValid(data.judul, 100)
        && teksValid(data.lokasi, 100)
        && data.waktuMulai is timestamp
        && (
          data.waktuSelesai == null
          || (data.waktuSelesai is timestamp && data.waktuSelesai > data.waktuMulai)
        )
        && data.statusSesi in ['BELUM_DIBUKA', 'DIBUKA', 'DITUTUP']
        && data.diarsipkan is bool;
    }

    function kodeQrValid(kodeQr) {
      return kodeQr is string && kodeQr.matches('^[0-9a-f]{32}$');
    }

    function profilBaruValid(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'nama', 'nim', 'email', 'peran', 'kodePeserta', 'dibuatPada'
        ])
        && request.resource.data.keys().hasOnly([
          'nama', 'nim', 'email', 'peran', 'kodePeserta', 'dibuatPada'
        ])
        && teksValid(request.resource.data.nama, 100)
        && teksValid(request.resource.data.nim, 32)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.peran == 'PRAKTIKAN'
        && request.resource.data.kodePeserta is string
        && request.resource.data.kodePeserta.matches('^[A-Z0-9]{8}$')
        && request.resource.data.dibuatPada == request.time
        && existsAfter(
          /databases/$(database)/documents/kodePeserta/$(request.resource.data.kodePeserta)
        )
        && getAfter(
          /databases/$(database)/documents/kodePeserta/$(request.resource.data.kodePeserta)
        ).data.uid == uid
        && getAfter(
          /databases/$(database)/documents/kodePeserta/$(request.resource.data.kodePeserta)
        ).data.nama == request.resource.data.nama
        && getAfter(
          /databases/$(database)/documents/kodePeserta/$(request.resource.data.kodePeserta)
        ).data.nim == request.resource.data.nim;
    }

    function mappingBaruValid(kode) {
      return signedIn()
        && request.resource.data.keys().hasAll(['uid', 'nama', 'nim'])
        && request.resource.data.keys().hasOnly(['uid', 'nama', 'nim', 'kodePeserta', 'peran'])
        && request.resource.data.uid == request.auth.uid
        && (!('kodePeserta' in request.resource.data) || request.resource.data.kodePeserta == kode)
        && (!('peran' in request.resource.data) || request.resource.data.peran == 'PRAKTIKAN')
        && teksValid(request.resource.data.nama, 100)
        && teksValid(request.resource.data.nim, 32)
        && existsAfter(pathPengguna(request.auth.uid))
        && getAfter(pathPengguna(request.auth.uid)).data.kodePeserta == kode
        && getAfter(pathPengguna(request.auth.uid)).data.nama == request.resource.data.nama
        && getAfter(pathPengguna(request.auth.uid)).data.nim == request.resource.data.nim;
    }

    // Validasi dokumen token FCM perangkat milik pengguna
    function perangkatTokenValid(data) {
      return data.keys().hasAll(['fcmToken'])
        && data.keys().hasOnly([
          'fcmToken', 'platform', 'deviceName', 'appVersion', 'dibuatPada', 'diperbaruiPada'
        ])
        && data.fcmToken is string
        && data.fcmToken.size() >= 10
        && data.fcmToken.size() <= 4096
        && (!('platform' in data) || data.platform is string)
        && (!('deviceName' in data) || data.deviceName is string)
        && (!('appVersion' in data) || data.appVersion is string)
        && (!('dibuatPada' in data) || data.dibuatPada is timestamp)
        && (!('diperbaruiPada' in data) || data.diperbaruiPada is timestamp);
    }

    function laboratoriumFieldsValid(data) {
      return data.keys().hasAll([
          'kodeLab', 'nama', 'lokasiGedung',
          'latitude', 'longitude', 'radiusPresensi', 'aktif'
        ])
        && teksValid(data.kodeLab, 32)
        && teksValid(data.nama, 100)
        && teksValid(data.lokasiGedung, 200)
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.radiusPresensi is number
        && data.radiusPresensi > 0
        && data.radiusPresensi <= 10000
        && data.aktif is bool;
    }

    function laboratoriumBaruValid() {
      return isAsisten()
        && request.resource.data.keys().hasOnly([
          'kodeLab', 'nama', 'lokasiGedung',
          'latitude', 'longitude', 'radiusPresensi', 'aktif'
        ])
        && laboratoriumFieldsValid(request.resource.data);
    }

    function laboratoriumUpdateValid() {
      return isAsisten()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kodeLab', 'nama', 'lokasiGedung',
          'latitude', 'longitude', 'radiusPresensi', 'aktif'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'kodeLab', 'nama', 'lokasiGedung',
          'latitude', 'longitude', 'radiusPresensi', 'aktif'
        ])
        && laboratoriumFieldsValid(request.resource.data);
    }

    function kelasBaruValid() {
      return isAsisten()
        && classDataValid(request.resource.data)
        && request.resource.data.asistenUid == request.auth.uid
        && request.resource.data.diarsipkan == false
        && request.resource.data.dibuatPada == request.time
        && (!('diperbaruiPada' in request.resource.data) || request.resource.data.diperbaruiPada == request.time);
    }

    function kelasUpdateValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAsisten()
        && resource.data.asistenUid == request.auth.uid
        && resource.data.diarsipkan == false
        && request.resource.data.asistenUid == resource.data.asistenUid
        && request.resource.data.dibuatPada == resource.data.dibuatPada
        && changed.hasOnly([
          'namaPraktikum', 'labId', 'gracePeriodMenit',
          'nominalDenda', 'diarsipkan', 'diperbaruiPada'
        ])
        && changed.hasAny([
          'namaPraktikum', 'labId', 'gracePeriodMenit',
          'nominalDenda', 'diarsipkan'
        ])
        && (!('namaPraktikum' in changed) || teksValid(request.resource.data.namaPraktikum, 100))
        && (!('labId' in changed) || request.resource.data.labId == null || teksValid(request.resource.data.labId, 128))
        && (!('gracePeriodMenit' in changed) || (
          request.resource.data.gracePeriodMenit is int
          && request.resource.data.gracePeriodMenit >= 0
          && request.resource.data.gracePeriodMenit <= 120
        ))
        && (!('nominalDenda' in changed) || (
          request.resource.data.nominalDenda is int
          && request.resource.data.nominalDenda >= 0
          && request.resource.data.nominalDenda <= 1000000
        ))
        && (!('diarsipkan' in changed) || request.resource.data.diarsipkan == true)
        && (!('diperbaruiPada' in changed) || request.resource.data.diperbaruiPada == request.time);
    }

    function anggotaBaruValid(anggotaId) {
      return isAsisten()
        && request.resource.data.keys().hasAll(['kelasId', 'uid', 'nama', 'nim', 'status'])
        && request.resource.data.keys().hasOnly(['kelasId', 'uid', 'nama', 'nim', 'status'])
        && request.resource.data.kelasId is string
        && request.resource.data.uid is string
        && anggotaId == request.resource.data.kelasId + '_' + request.resource.data.uid
        && isPemilikKelas(request.resource.data.kelasId)
        && kelasAktif(request.resource.data.kelasId)
        && request.resource.data.status == 'AKTIF'
        && exists(pathPengguna(request.resource.data.uid))
        && get(pathPengguna(request.resource.data.uid)).data.peran == 'PRAKTIKAN'
        && request.resource.data.nama == get(pathPengguna(request.resource.data.uid)).data.nama
        && request.resource.data.nim == get(pathPengguna(request.resource.data.uid)).data.nim;
    }

    function anggotaStatusUpdateValid(anggotaId) {
      return isAsisten()
        && resource.data.kelasId is string
        && resource.data.uid is string
        && anggotaId == resource.data.kelasId + '_' + resource.data.uid
        && isPemilikKelas(resource.data.kelasId)
        && kelasAktif(resource.data.kelasId)
        && get(pathPengguna(resource.data.uid)).data.peran == 'PRAKTIKAN'
        && request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nama == resource.data.nama
        && request.resource.data.nim == resource.data.nim
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        && request.resource.data.status in ['AKTIF', 'NONAKTIF'];
    }

    function sesiBaruValid(sesiId) {
      return isAsisten()
        && sesiDataValid(request.resource.data)
        && !('notificationEventId' in request.resource.data)
        && request.resource.data.statusSesi == 'BELUM_DIBUKA'
        && request.resource.data.diarsipkan == false
        && isPemilikKelas(request.resource.data.kelasId)
        && kelasAktif(request.resource.data.kelasId)
        && existsAfter(pathQr(sesiId))
        && kodeQrValid(getAfter(pathQr(sesiId)).data.kodeQr);
    }

    function sesiJadwalUpdateValid() {
      return !kelasDiarsipkan(resource.data.kelasId)
        && request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'judul', 'labId', 'lokasi', 'waktuMulai', 'waktuSelesai', 'notificationEventId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'judul', 'labId', 'lokasi', 'waktuMulai', 'waktuSelesai'
        ])
        && sesiDataValid(request.resource.data);
    }

    function kelasDiarsipkan(kelasId) {
      return get(pathKelas(kelasId)).data.diarsipkan == true;
    }

    function sesiStatusUpdateValid() {
      return request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statusSesi', 'notificationEventId'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusSesi'])
        && (
          (
            resource.data.statusSesi == 'BELUM_DIBUKA'
            && request.resource.data.statusSesi == 'DIBUKA'
            && !kelasDiarsipkan(resource.data.kelasId)
          )
          || (
            resource.data.statusSesi == 'DIBUKA'
            && request.resource.data.statusSesi == 'DITUTUP'
          )
        );
    }

    function sesiArsipUpdateValid() {
      return request.resource.data.kelasId == resource.data.kelasId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diarsipkan'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['diarsipkan'])
        && resource.data.diarsipkan == false
        && request.resource.data.diarsipkan == true
        && resource.data.statusSesi != 'DIBUKA';
    }

    function izinBaruValid(izinId) {
      let sesiId = request.resource.data.sesiId;
      let kelasId = request.resource.data.kelasId;
      let uid = request.auth.uid;

      return isPraktikan()
        && request.resource.data.keys().hasAll([
          'sesiId', 'kelasId', 'uid', 'alasan', 'statusIzin',
          'diperiksaOleh', 'waktuPeriksa', 'kategoriAi',
          'statusAi', 'modelAi', 'waktuAi', 'dibuatPada'
        ])
        && request.resource.data.keys().hasOnly([
          'sesiId', 'kelasId', 'uid', 'alasan', 'statusIzin',
          'diperiksaOleh', 'waktuPeriksa', 'kategoriAi',
          'statusAi', 'modelAi', 'waktuAi', 'dibuatPada'
        ])
        && sesiId is string
        && kelasId is string
        && request.resource.data.uid == uid
        && izinId == sesiId + '_' + uid
        && teksValid(request.resource.data.alasan, 2000)
        && request.resource.data.statusIzin == 'MENUNGGU'
        && request.resource.data.statusAi == 'BELUM'
        && request.resource.data.diperiksaOleh == null
        && request.resource.data.waktuPeriksa == null
        && request.resource.data.kategoriAi == null
        && request.resource.data.modelAi == null
        && request.resource.data.waktuAi == null
        && request.resource.data.dibuatPada == request.time
        && exists(pathSesi(sesiId))
        && get(pathSesi(sesiId)).data.kelasId == kelasId
        && get(pathSesi(sesiId)).data.statusSesi in ['BELUM_DIBUKA', 'DIBUKA']
        && get(pathSesi(sesiId)).data.diarsipkan == false
        && exists(pathKelas(kelasId))
        && kelasAktif(kelasId)
        && exists(pathAnggota(kelasId, uid))
        && anggotaAktif(kelasId, uid)
        && !exists(pathIzin(sesiId, uid))
        && !existsAfter(pathPresensi(sesiId, uid));
    }

    function presensiMilikPraktikan(data, presensiId) {
      return data.keys().hasAll(['uid', 'sesiId'])
        && isPraktikan()
        && data.uid == request.auth.uid
        && data.sesiId is string
        && presensiId == data.sesiId + '_' + request.auth.uid;
    }

    function presensiDapatDilihatPraktikan(data) {
      return data.keys().hasAll(['uid'])
        && isPraktikan()
        && data.uid == request.auth.uid;
    }

    function presensiBisaDibacaAsisten(data) {
      return data.keys().hasAll(['sesiId'])
        && data.sesiId is string
        && sesiDimilikiAsisten(data.sesiId);
    }

    function presensiIdKosongMilikPraktikan(presensiId) {
      return isPraktikan()
        && presensiId.matches('^.+_' + request.auth.uid + '$');
    }

    function izinKeputusanValid() {
      let data = request.resource.data;
      let sesiId = resource.data.sesiId;

      return isAsisten()
        && resource.data.statusIzin == 'MENUNGGU'
        && sesiId is string
        && resource.data.kelasId == get(pathSesi(sesiId)).data.kelasId
        && sesiDimilikiAsisten(sesiId)
        && data.diff(resource.data).affectedKeys().hasAll([
          'statusIzin', 'diperiksaOleh', 'waktuPeriksa'
        ])
        && data.diff(resource.data).affectedKeys().hasOnly([
          'statusIzin', 'diperiksaOleh', 'waktuPeriksa', 'notificationEventId'
        ])
        && data.statusIzin in ['DISETUJUI', 'DITOLAK']
        && data.diperiksaOleh == request.auth.uid
        && data.waktuPeriksa == request.time;
    }

    function jenisNotifikasiSesi(before, after) {
      return before.statusSesi == 'BELUM_DIBUKA' && after.statusSesi == 'DIBUKA'
        ? 'SESI_DIBUKA'
        : after.diff(before).affectedKeys().hasAny(['judul', 'labId', 'waktuMulai', 'waktuSelesai'])
          ? 'JADWAL_BERUBAH'
          : null;
    }

    function jenisNotifikasiIzin(before, after) {
      return before.statusIzin != 'MENUNGGU' ? null
        : after.statusIzin == 'DISETUJUI' ? 'IZIN_DISETUJUI'
        : after.statusIzin == 'DITOLAK' ? 'IZIN_DITOLAK'
        : null;
    }

    function idEventNotifikasiValid(eventId) {
      return eventId is string && eventId.matches('^[A-Za-z0-9]{20}$');
    }

    function notifikasiDiwajibkan() {
      let config = /databases/$(database)/documents/notificationConfig/runtime;
      return exists(config) && get(config).data.get('requireIntent', false) == true;
    }

    function dataIntentNotifikasiValid(data, entityId, type) {
      return data.keys().hasOnly(['entityId', 'type', 'createdAt', 'nextAttemptAt'])
        && data.entityId == entityId && data.type == type
        && data.createdAt == request.time && data.nextAttemptAt == request.time;
    }

    function intentNotifikasiBaruValid(eventId, entityId, type) {
      let intent = /databases/$(database)/documents/notificationIntents/$(eventId);
      return !exists(intent) && existsAfter(intent)
        && dataIntentNotifikasiValid(getAfter(intent).data, entityId, type);
    }

    function updateNotifikasiValid(entityId, type) {
      let eventId = request.resource.data.get('notificationEventId', null);
      let changed = request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationEventId']);
      return changed
        ? type != null && idEventNotifikasiValid(eventId) && intentNotifikasiBaruValid(eventId, entityId, type)
        : type == null || !notifikasiDiwajibkan();
    }

    function sumberIntentNotifikasiValid(eventId, source, isIzin) {
      let before = get(source).data;
      let after = getAfter(source).data;
      return before.get('notificationEventId', null) != eventId
        && after.get('notificationEventId', null) == eventId
        && request.resource.data.type == (isIzin
          ? jenisNotifikasiIzin(before, after)
          : jenisNotifikasiSesi(before, after));
    }

    function intentNotifikasiValid(eventId) {
      let data = request.resource.data;
      let id = data.entityId;
      return isAsisten() && idEventNotifikasiValid(eventId)
        && id is string && id.size() <= 256 && id.matches('^[^/]+$') && !(id in ['.', '..'])
        && dataIntentNotifikasiValid(data, id, data.type)
        && (
          (data.type in ['SESI_DIBUKA', 'JADWAL_BERUBAH']
            && sumberIntentNotifikasiValid(eventId, pathSesi(id), false))
          || (data.type in ['IZIN_DISETUJUI', 'IZIN_DITOLAK']
            && sumberIntentNotifikasiValid(eventId, /databases/$(database)/documents/izin/$(id), true))
        );
    }

    function kodeMilikSendiri(kode) {
      return signedIn()
        && exists(pathPengguna(request.auth.uid))
        && get(pathPengguna(request.auth.uid)).data.kodePeserta == kode;
    }

    match /pengguna/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if profilBaruValid(uid);
      allow update, delete: if false;

      match /perangkat/{installationId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && installationId.size() > 0
          && installationId.size() <= 128
          && perangkatTokenValid(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /kodePeserta/{kode} {
      allow get: if isAsisten() || kodeMilikSendiri(kode);
      allow list: if isAsisten()
        && (!('peran' in resource.data) || resource.data.peran == 'PRAKTIKAN');
      allow create: if mappingBaruValid(kode);
      allow update, delete: if false;
    }

    match /laboratorium/{labId} {
      allow get, list: if signedIn();
      allow create: if laboratoriumBaruValid();
      allow update: if laboratoriumUpdateValid();
      allow delete: if isAsisten();
    }

    match /kelas/{kelasId} {
      allow get: if (
          isAsisten() && resource.data.asistenUid == request.auth.uid
        ) || (
          isPraktikan() && exists(pathAnggota(kelasId, request.auth.uid))
        ) || (
          signedIn() && resource.data.diarsipkan == false
        );
      allow list: if isAsisten();
      allow create: if kelasBaruValid();
      allow update: if kelasUpdateValid();
      allow delete: if false;
    }

    match /keanggotaan/{anggotaId} {
      allow get: if (
          resource == null && isAsisten()
        ) || (
          resource != null
          && isAsisten()
          && isPemilikKelas(resource.data.kelasId)
        ) || (
          resource != null
          && isPraktikan()
          && resource.data.uid == request.auth.uid
          && anggotaId == resource.data.kelasId + '_' + request.auth.uid
        );
      allow list: if (
          isPraktikan()
          && resource.data.uid == request.auth.uid
          && resource.data.status == 'AKTIF'
        ) || (
          isAsisten()
          && resource.data.kelasId is string
          && isPemilikKelas(resource.data.kelasId)
        );
      allow create: if anggotaBaruValid(anggotaId);
      allow update: if anggotaStatusUpdateValid(anggotaId);
      allow delete: if false;
    }

    match /sesi/{sesiId} {
      allow get: if (
          isAsisten() && isPemilikKelas(resource.data.kelasId)
        ) || praktikanDapatBacaSesi(
          sesiId,
          resource.data.kelasId,
          resource.data.diarsipkan
        );
      allow list: if (
          isAsisten() && isPemilikKelas(resource.data.kelasId)
        ) || (
          praktikanDapatBacaSesi(
            sesiId,
            resource.data.kelasId,
            resource.data.diarsipkan
          )
          && resource.data.diarsipkan == false
          && kelasAktif(resource.data.kelasId)
          && anggotaAktif(resource.data.kelasId, request.auth.uid)
        ) || (
          signedIn()
          && resource.data.diarsipkan == false
          && resource.data.labId is string
          && resource.data.labId.size() > 0
        );
      allow create: if sesiBaruValid(sesiId);
      allow update: if isAsisten()
        && isPemilikKelas(resource.data.kelasId)
        && resource.data.diarsipkan == false
        && (
          sesiJadwalUpdateValid()
          || sesiStatusUpdateValid()
          || sesiArsipUpdateValid()
        ) && updateNotifikasiValid(sesiId, jenisNotifikasiSesi(resource.data, request.resource.data));
      allow delete: if false;

      match /rahasia/{rahasiaId} {
        allow get: if rahasiaId == 'qr'
          && sesiDimilikiAsisten(sesiId);
        allow list: if false;
        allow create: if rahasiaId == 'qr'
          && isAsisten()
          && !exists(pathSesi(sesiId))
          && existsAfter(pathSesi(sesiId))
          && !exists(pathQr(sesiId))
          && getAfter(pathSesi(sesiId)).data.kelasId is string
          && isPemilikKelas(getAfter(pathSesi(sesiId)).data.kelasId)
          && getAfter(pathSesi(sesiId)).data.statusSesi == 'BELUM_DIBUKA'
          && getAfter(pathSesi(sesiId)).data.diarsipkan == false
          && request.resource.data.keys().hasAll(['kodeQr'])
          && request.resource.data.keys().hasOnly(['kodeQr'])
          && kodeQrValid(request.resource.data.kodeQr);
        allow update, delete: if false;
      }
    }

    match /presensi/{presensiId} {
      allow get: if (
          resource == null && presensiIdKosongMilikPraktikan(presensiId)
        ) || (
          resource != null
          && presensiMilikPraktikan(resource.data, presensiId)
        ) || (
          resource != null
          && presensiBisaDibacaAsisten(resource.data)
        );
      allow list: if presensiDapatDilihatPraktikan(resource.data)
        || (
          isAsisten()
          && kelasDimilikiAsistenDiData(resource.data)
        );
      allow create, update, delete: if false;
    }

    match /izin/{izinId} {
      allow get: if (
        isPraktikan()
        && (
          (resource == null && izinKosongDapatDibacaPraktikan(izinId))
          || (
            resource != null
            && resource.data.uid == request.auth.uid
            && izinId == resource.data.sesiId + '_' + request.auth.uid
          )
        )
      ) || (
        resource != null
        && resource.data.sesiId is string
        && sesiDimilikiAsisten(resource.data.sesiId)
      );

      allow list: if (
        isPraktikan()
        && resource.data.uid == request.auth.uid
      ) || (
        isAsisten()
        && kelasDimilikiAsistenDiData(resource.data)
      );

      allow create: if izinBaruValid(izinId);
      allow update: if izinKeputusanValid()
        && updateNotifikasiValid(izinId, jenisNotifikasiIzin(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /notificationIntents/{eventId} {
      allow create: if intentNotifikasiValid(eventId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
